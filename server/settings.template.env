# The upload server's settings (slam_it_server.config), one environment variable each. Copy
# this file outside the repository, fill it in, and load it into the server's environment.
# Every value here is a placeholder. Make the secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# The codes that may upload, comma-separated, each at least 12 characters, and made at
# random as the secrets are: a code is a password, and guesses at one are not rate-limited.
#   python -c "import secrets; print(secrets.token_urlsafe(9))"
SLAM_IT_INVITE_CODES=replace-with-a-code,replace-with-another
# The token workers present, at least 32 characters; the worker's own
# SLAM_IT_WORKER_TOKEN must match it.
SLAM_IT_WORKER_TOKEN=replace-with-a-long-random-worker-token
# The key folder storage signs its links with, at least 32 characters (needed with s3 too).
SLAM_IT_SIGNING_KEY=replace-with-a-long-random-signing-key
# "s3", or "folder:<path>" to keep the files on this machine.
SLAM_IT_STORAGE=s3
# The bucket, for "s3".
SLAM_IT_S3_ENDPOINT=https://s3.example.invalid
SLAM_IT_S3_BUCKET=replace-with-the-bucket
SLAM_IT_S3_KEY_ID=replace-with-the-key-id
SLAM_IT_S3_SECRET=replace-with-the-secret
SLAM_IT_S3_REGION=replace-with-the-region
# The server's own address, which folder storage's links point at.
SLAM_IT_PUBLIC_URL=https://example.invalid
# The job list's SQLite file (on Railway, on the service's volume).
SLAM_IT_DATABASE=/data/jobs.sqlite3
# The viewer's folder, which holds the pages.
SLAM_IT_VIEWER=/app/viewer
# 1 puts every page behind an invite code (HTTP Basic auth), for the staging deploy.
SLAM_IT_STAGING=1
# 1 keeps each upload with its result until the job is deleted, 7 days after it ends: the
# local demo's, with folder storage only (refused with s3). A deployment leaves it 0, and
# deletes each upload once imported.
SLAM_IT_KEEP_UPLOADS=0
