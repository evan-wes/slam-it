# The upload server's settings (slam_it_all_server.config), one environment variable each. Copy
# this file outside the repository, fill it in, and load it into the server's environment.
# Every value here is a placeholder. Make the secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# The codes that may upload, comma-separated, each at least 12 characters.
SLAM_IT_ALL_INVITE_CODES=replace-with-a-code,replace-with-another
# The token workers present, at least 32 characters; the worker's own
# SLAM_IT_ALL_WORKER_TOKEN must match it.
SLAM_IT_ALL_WORKER_TOKEN=replace-with-a-long-random-worker-token
# The key folder storage signs its links with, at least 32 characters.
SLAM_IT_ALL_SIGNING_KEY=replace-with-a-long-random-signing-key
# "s3", or "folder:<path>" to keep the files on this machine.
SLAM_IT_ALL_STORAGE=s3
# The bucket, for "s3".
SLAM_IT_ALL_S3_ENDPOINT=https://s3.example.invalid
SLAM_IT_ALL_S3_BUCKET=replace-with-the-bucket
SLAM_IT_ALL_S3_KEY_ID=replace-with-the-key-id
SLAM_IT_ALL_S3_SECRET=replace-with-the-secret
SLAM_IT_ALL_S3_REGION=replace-with-the-region
# The server's own address, which folder storage's links point at.
SLAM_IT_ALL_PUBLIC_URL=https://example.invalid
# The job list's SQLite file (on Railway, on the service's volume).
SLAM_IT_ALL_DATABASE=/data/jobs.sqlite3
# The viewer's folder, which holds the pages.
SLAM_IT_ALL_VIEWER=/app/viewer
# 1 puts every page behind an invite code (HTTP Basic auth), for the staging deploy.
SLAM_IT_ALL_STAGING=1
